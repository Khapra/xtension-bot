# Xtension Bot Configuration v1.1.0
# Copy this file to .env and fill in your values

# REQUIRED: Bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# Admin user IDs (comma-separated)
# Get your ID from @userinfobot on Telegram
# Example: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# Optional: Telegram API credentials (not needed for bots)
# Get from https://my.telegram.org if needed
API_ID=
API_HASH=

# Session configuration
SESSION_TYPE=sqlite
SESSION_NAME=xtension_bot

# Directory configuration
PLUGIN_DIR=plugins
DATA_DIR=data
SESSION_DIR=sessions

# Logging level: DEBUG, INFO, WARNING, ERROR
# Use DEBUG for development (verbose logging)
# Use INFO for production (clean logging)
LOG_LEVEL=INFO

# Plugin system
ENABLE_PLUGINS=true
